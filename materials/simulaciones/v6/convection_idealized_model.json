{
  "evidence_class": "SIMULATION_IDEALIZED_MODEL",
  "noise": "Noiseless to isolate model confounding",
  "title_es": "La atenuación extra puede parecer difusión y ajustar perfectamente",
  "title_en": "Additional attenuation can look like diffusion and fit perfectly",
  "physical_model": "Ideal monopolar PGSE with rectangular, narrow gradient pulses (delta << Delta), q=gamma G delta in rad/m, b approximately q^2 Delta.",
  "assumptions": [
    "Free Brownian diffusion with D constant and independent of velocity.",
    "Each spin has a constant velocity during the encoding interval; the ensemble velocities have a zero-mean Gaussian distribution with standard deviation sigma_v.",
    "Velocity variance does not vary with Delta in this mathematical comparison.",
    "Same chosen b-values compared across Delta; this does not impose instrument gradient limits or model any Bruker pulse program.",
    "No exchange, time-dependent flow, restriction, gradient nonuniformity, relaxation or phase errors."
  ],
  "parameters": {
    "D_true_m2_per_s": 8e-10,
    "sigma_v_m_per_s": 0.0001,
    "sigma_v_micrometre_per_s": 100,
    "Delta_ms": [
      50,
      100,
      150
    ]
  },
  "derivation_steps": [
    "For one velocity v, E(q,Delta|v)=exp(i q v Delta) exp(-q^2 D Delta).",
    "The expectation of exp(i q v Delta) for v~N(0,sigma_v^2) is exp(-0.5 (q sigma_v Delta)^2).",
    "With b approximately q^2 Delta, the combined signal equals exp[-b (D + 0.5 sigma_v^2 Delta)].",
    "A diffusion-only fit therefore returns D_app = D + 0.5 sigma_v^2 Delta with exact zero residual in this noiseless ideal example."
  ],
  "derivation_provenance": "Explicit inference under the stated Gaussian-velocity assumption from the primary PGSE signal/propagator formalism; the D_app formula is not quoted as an experimentally general law from either paper.",
  "sources": [
    {
      "title": "Limits to flow detection in phase contrast MRI",
      "authors": "Williamson, Komlosh, Benjamini, Basser",
      "year": 2020,
      "doi": "10.1016/j.jmro.2020.100004",
      "url": "https://pmc.ncbi.nlm.nih.gov/articles/PMC7745993/",
      "evidence": "Original research. Section 2.1, equations 1-3 give coherent-flow PGSE E=exp(i q v Delta-q^2 D Delta), the Fourier-transform average propagator, and q=gamma g delta for narrow rectangular pulses.",
      "access_note": "Search returned original article text, including equations 1-3; a direct open triggered a browser challenge."
    },
    {
      "title": "Separation of velocity distribution and diffusion using PFG NMR",
      "authors": "Gottwald, Kuran, Scheler",
      "year": 2003,
      "doi": "10.1016/S1090-7807(03)00130-7",
      "url": "https://pubmed.ncbi.nlm.nih.gov/12810021/",
      "evidence": "Original-research abstract explicitly states that distributions of directed-motion velocities cause signal attenuation and that a usual gradient-incremented PFG experiment cannot separate these and diffusion contributions."
    }
  ],
  "teaching_message_es": "Tres rampas con Delta distinta pueden revelar dependencia del resultado. Este ejemplo muestra un confusor posible; dependencia con Delta no identifica por sí sola convección.",
  "teaching_message_en": "Three ramps at different Delta can reveal result dependence. This example demonstrates one possible confounder; Delta dependence alone does not identify convection.",
  "limits": [
    "Not a model of general convection or of double-stimulated-echo compensation.",
    "The values 100 micrometres/s and D=0.8e-9 are hypothetical; they are not measured values for the user's samples.",
    "No claim that a perfectly fitted exponential proves Brownian molecular diffusion."
  ],
